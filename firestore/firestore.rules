rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isLogistics() {
      return signedIn() && (role() == 'admin' || role() == 'logistics');
    }

    function isProgram() {
      return signedIn() && (role() == 'admin' || role() == 'program');
    }

    function isOps() {
      return signedIn() && (role() == 'admin' || role() == 'program' || role() == 'logistics');
    }

    function accessDocId(personId) {
      return request.auth.uid + "_" + personId;
    }

    function hasGuestAccess(personId) {
      return signedIn()
        && personId is string
        && exists(/databases/$(database)/documents/person_access/$(accessDocId(personId)));
    }

    match /dashboard_metrics/{docId} {
      allow read: if isOps();
      allow write: if false;
    }

    match /people/{docId} {
      allow read: if isOps() || hasGuestAccess(docId);
      allow write: if false;
    }

    match /participation/{docId} {
      allow read: if isOps() || hasGuestAccess(resource.data.personId);
      allow write: if false;
    }

    match /agenda_items/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /hotel_bookings/{docId} {
      allow read: if isLogistics() || hasGuestAccess(resource.data.personId);
      allow write: if false;
    }

    match /flight_segments/{docId} {
      allow read: if isLogistics() || hasGuestAccess(resource.data.personId);
      allow write: if false;
    }

    match /pickup_tasks/{docId} {
      allow read: if isLogistics() || hasGuestAccess(resource.data.personId);
      allow write: if false;
    }

    match /data_quality_issues/{docId} {
      allow read: if isOps();
      allow update: if isAdmin() || isProgram();
      allow create, delete: if false;
    }

    match /sync_logs/{docId} {
      allow read: if isOps();
      allow write: if false;
    }

    match /person_sensitive/{docId} {
      allow read: if isAdmin() || hasGuestAccess(docId);
      allow write: if false;
    }

    match /raw_sheet_snapshots/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /person_access/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /user_roles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
  }
}
